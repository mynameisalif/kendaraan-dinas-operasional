{
  "info": {
    "_postman_id": "8e45a110-7b22-4c93-9a8d-202611120001",
    "name": "SI-KDO BMD — RESTful API Pengelolaan Kendaraan Dinas Operasional",
    "description": "Koleksi pengujian lengkap RESTful API Sistem Pengelolaan Kendaraan Dinas Operasional (KDO) milik Perangkat Daerah (Barang Milik Daerah / BMD). Mencakup operasi CRUD (GET List, GET Detail, POST Create, PUT/PATCH Update, DELETE) beserta pengujian validasi & error handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/kendaraan-dinas-operasional",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Dashboard & Statistik BMD",
      "item": [
        {
          "name": "GET Ringkasan Dashboard KDO",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code adalah 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response memiliki struktur summary dan distribusi', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('success');",
                  "    pm.expect(jsonData.data).to.have.property('summary');",
                  "    pm.expect(jsonData.data).to.have.property('distribusi_perangkat');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/dashboard.php",
              "host": ["{{base_url}}"],
              "path": ["api", "dashboard.php"]
            }
          }
        }
      ]
    },
